{
  "name": "hcl-assistant-mock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.pages.config.js && python3 scripts/check_preview_bundle.py && npm run test:views",
    "test:browser": "playwright test",
    "build:preview": "tsc --noEmit && vite build --config vite.pages.config.js",
    "chat": "python3 scripts/start_development_chat.py",
    "test:views": "node --test tests/javascript/inspection-view.test.js tests/javascript/lab-lifecycle.test.js",
    "build:cloud": "tsc --noEmit && vite build && python3 scripts/build_cloud_runtime.py"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
