@@ -0,0 +1,70 @@
+"""Local candidate content contract; no activation, grant writes or classifier.
+
+The label records an explicitly authorized input scope, not a claim that the
+server can detect all sensitive text. Existing unclassified sources stay read
+only. A new grant cannot silently inherit a previous grant's conversation.
+"""
+import copy
+from packages.store.ledger import Fault
+
+KIND = 'INTERNAL_SELF_USE'
+CONTENT_SCOPE = 'SELF_AUTHORED_NON_SENSITIVE_V1'
+
+
+def contract(grant):
+    return {'version': 1, 'access_kind': KIND, 'actor_tenant': grant['tenant'],
+            'grant_id': grant['grant_id'], 'content_scope': CONTENT_SCOPE,
+            'approval_evidence_digest': grant['approval_evidence_digest']}
+
+
+
+def privacy_request(request, conversation):
+    previous=conversation.get('content_authorization')
+    event=request.get('event',{});commands=event.get('revisions')
+    return bool(previous and previous.get('access_kind')==KIND
+                and event.get('type')=='revision' and not request.get('development_chat')
+                and set(event)<={'type','text','revisions'} and isinstance(commands,list) and commands
+                and all(isinstance(c,dict) and set(c)=={'action','target_ids'}
+                        and c['action'] in {'STOP_USING','DELETE'} and isinstance(c['target_ids'],list)
+                        and c['target_ids'] for c in commands)
+                and not request.get('source_refs') and not request.get('development_execution'))
+
+
+def authorize(controller, request, conversation):
+    """Run before any Controller write, including provider-free mutations."""
+    previous = conversation.get('content_authorization')
+    service = controller.live_chat
+    budget = service.budget if service else None
+    resolve = getattr(budget, 'content_authorization', None)
+    if privacy_request(request, conversation):
+        if budget is not None and hasattr(budget,'auth') and not budget.auth.active(budget.session_key):
+            raise Fault(401,'Account session expired')
+        request['event']['text'] = ''
+        return copy.deepcopy(previous)
+    current = resolve(conversation) if resolve else None
+    if not previous and not current:
+        return None
+    if current is None or (previous is not None and previous != current):
+        raise Fault(403, '当前授权不能继续此会话；已有记录仍可查看')
+    event = request.get('event', {})
+    if (conversation.get('memory') not in {'TEMPORARY', 'CONVERSATION'} or conversation.get('topic_id') is not None
+            or request.get('development_execution') or request.get('source_refs')
+            or request.get('scope', {}).get('branch_id', 'actual') != 'actual'
+            or event.get('type', 'message') != 'message' or set(event) - {'type', 'text'}
+            or not request.get('development_chat')):
+        raise Fault(403, '内部自用仅支持本人原创非敏感消息及同会话历史')
+    for source in controller.store.db.execute('SELECT body FROM sources WHERE tenant=?', (conversation['tenant_id'],)).fetchall():
+        # Source checks also run against the actual prompt below. This early
+        # check prevents a legacy conversation from gaining a new contract.
+        import json
+        value = json.loads(source['body'])
+        if value['conversation_id'] == conversation['id'] and value.get('content_authorization') != current:
+            raise Fault(403, '旧会话没有此内容授权，请新建对话；已有记录仍可查看')
+    return current
+
+
+def source_allowed(source, authorization, conversation_id):
+    if authorization is None:
+        return source.get('content_authorization') is None
+    return (source.get('content_authorization') == authorization
+            and source.get('conversation_id') == conversation_id and source.get('topic_id') is None)
