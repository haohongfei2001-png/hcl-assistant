# TEMPLATE ONLY. Enter credentials in your server's secure secret interface.
# Never commit a filled file or put values into VITE_*, chat, logs, or browser storage.
HCLA_DEEPSEEK_API_KEY=
HCLA_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Must be explicitly chosen; no automatic model fallback.
HCLA_DEEPSEEK_MODEL=deepseek-v4-pro
# Existing server operator access secret, at least 24 characters. Not the provider key.
HCLA_DEV_ACCESS_TOKEN=
# The cloud-smoke six-call grant is exhausted. Enter a separately approved local-use allocation.
HCLA_DEV_MAX_REQUESTS=
HCLA_DEV_MAX_COST_USD=
HCLA_DEV_MAX_OUTPUT_TOKENS=8192
# Enter current official cache-miss input and maximum output rates for the chosen model.
HCLA_DEV_INPUT_USD_PER_MILLION=1.32
HCLA_DEV_OUTPUT_USD_PER_MILLION=3.96
HCLA_DEV_BUDGET_ID=
# Optional exact reviewed three-file runtime artifact, never a research checkout.
HCL_DEVELOPMENT_ARTIFACT=
